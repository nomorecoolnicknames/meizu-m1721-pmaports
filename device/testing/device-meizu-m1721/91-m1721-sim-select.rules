// m1721: allow plugdev users to run sim-select via pkexec without a password.
// subject.active is unreliable under greetd/phosh (same as the MM voice grant),
// so gate on group membership only.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/sim-select" &&
        subject.isInGroup("plugdev"))
        return polkit.Result.YES;
});
