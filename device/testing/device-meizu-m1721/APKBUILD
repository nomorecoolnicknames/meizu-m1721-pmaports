# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-meizu-m1721
pkgdesc="Meizu M6 Note"
pkgver=1
pkgrel=32
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
install="$pkgname.post-install"
depends="
	firmware-meizu-m1721
	firmware-qcom-adreno-a530
	linux-postmarketos-qcom-msm8953
	lk2nd-msm8953
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	i2c-tools
	soc-qcom-msm8953
	soc-qcom-msm8953-modem
	py3-gobject3
	gtk4.0
	libadwaita
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	$pkgname.post-install
	00-m1721-logdump.sh
	00-m1721-gpu-firmware.files
	m1721-diag.start
	ucm2-meizu-m1721.conf
	ucm2-HiFi.conf
	ucm2-VoiceCall.conf
	libcamera-imx362.yaml
	libcamera-s5k3p8sp.yaml
	megapixels-meizu-m1721.conf
	gps
	batmon
	batmon.initd
	50-modem-up.start
	sim-select
	sim-switcher.py
	m1721-sim-switcher.desktop
	torch
	90-m1721-modemmanager-voice.rules
	91-m1721-sim-select.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# bring-up only: initramfs hook dumping dmesg into the expendable
	# 'logdump' partition so boot logs survive without UART/USB
	install -Dm644 "$srcdir"/00-m1721-logdump.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks/

	# pull the Adreno 506 microcode + zap shader into the initramfs so the
	# GPU comes up in early boot; otherwise the fw only loads from the rootfs
	# (~200s in) after phoc has already fallen back to software rendering
	install -Dm644 "$srcdir"/00-m1721-gpu-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files/

	# bring-up only: late-boot diagnostic collector run by the OpenRC 'local'
	# service; snapshots net/charger/sensor state into the logdump partition
	# every 10s so it is readable from TWRP even when on-device ssh is dead
	install -Dm755 "$srcdir"/m1721-diag.start \
		"$pkgdir"/etc/local.d/m1721-diag.start

	# ALSA UCM: HiFi verb (WCD earpiece/headphones/mics on PRI_MI2S + Cirrus
	# CS35L35 boosted speaker on QUAT_MI2S). Verified live on-device; the
	# speaker is the phosh default output. See SOUND_CS35L35_ROUTING.md in the
	# port docs.
	install -Dm644 "$srcdir"/ucm2-meizu-m1721.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/meizu-m1721/meizu-m1721.conf
	install -Dm644 "$srcdir"/ucm2-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Meizu/m1721/HiFi.conf
	install -Dm644 "$srcdir"/ucm2-VoiceCall.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Meizu/m1721/VoiceCall.conf

	# libcamera simple/SoftISP tuning: pinned black level (disables the
	# drifting histogram auto-guess) for both sensors
	install -Dm644 "$srcdir"/libcamera-imx362.yaml \
		"$pkgdir"/etc/libcamera/ipa/simple/imx362.yaml
	install -Dm644 "$srcdir"/libcamera-s5k3p8sp.yaml \
		"$pkgdir"/etc/libcamera/ipa/simple/s5k3p8sp.yaml

	# Megapixels/libmegapixels device config (rear imx362 via qcom-camss);
	# matched by DT compatible "meizu,m1721"
	install -Dm644 "$srcdir"/megapixels-meizu-m1721.conf \
		"$pkgdir"/usr/share/megapixels/config/meizu,m1721.conf

	# late-modem ModemManager kick (OpenRC 'local'). GNSS is NOT auto-enabled
	# anymore (a permanently-searching GPS drains + heats); use the gps toggle.
	install -Dm755 "$srcdir"/gps "$pkgdir"/usr/bin/gps
	install -Dm755 "$srcdir"/50-modem-up.start \
		"$pkgdir"/etc/local.d/50-modem-up.start

	# battery monitor / power-hog sampler (batmon report)
	install -Dm755 "$srcdir"/batmon "$pkgdir"/usr/bin/batmon
	install -Dm755 "$srcdir"/batmon.initd "$pkgdir"/etc/init.d/batmon

	# small userspace helpers: runtime SIM-slot switch (QMI UIM provisioning)
	# and rear-flash torch (AW36413); both need root
	install -Dm755 "$srcdir"/sim-select "$pkgdir"/usr/bin/sim-select
	install -Dm755 "$srcdir"/torch "$pkgdir"/usr/bin/torch

	# GUI SIM switching: one consolidated Adwaita app (not two bare icons)
	install -Dm755 "$srcdir"/sim-switcher.py "$pkgdir"/usr/bin/sim-switcher
	install -Dm644 "$srcdir"/m1721-sim-switcher.desktop \
		-t "$pkgdir"/usr/share/applications/

	# polkit: pmOS grants plugdev Device.Control/Contacts/Messaging/Location
	# but NOT Voice -> gnome-calls accept/hangup fail Unauthorized. Grant it.
	install -Dm644 "$srcdir"/90-m1721-modemmanager-voice.rules \
		"$pkgdir"/etc/polkit-1/rules.d/90-m1721-modemmanager-voice.rules
	install -Dm644 "$srcdir"/91-m1721-sim-select.rules \
		"$pkgdir"/etc/polkit-1/rules.d/91-m1721-sim-select.rules
}

