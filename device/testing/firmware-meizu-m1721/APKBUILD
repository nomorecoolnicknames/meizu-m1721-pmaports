# Maintainer: nomorecoolnicknames <78512247+nomorecoolnicknames@users.noreply.github.com>
pkgname=firmware-meizu-m1721
pkgver=1
pkgrel=0
pkgdesc="Adreno 506 ZAP shader firmware for the Meizu M6 Note (m1721)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps !spdx pmb:cross-native"
# The a506 ZAP shader is fetched from the MeizuCustoms LineageOS vendor tree
# (byte-identical to the stock /vendor/firmware blobs). The a530 render
# microcode is provided separately by the firmware-qcom-adreno-a530 package,
# which device-meizu-m1721 already depends on.
_sha=8c2cab935a0226d9f922104cfd265f9c288a0619
_url="https://raw.githubusercontent.com/meizucustoms/proprietary_vendor_meizu/$_sha/m1721/proprietary/vendor/firmware"
source="
	a506_zap.mdt::$_url/a506_zap.mdt
	a506_zap.b00::$_url/a506_zap.b00
	a506_zap.b01::$_url/a506_zap.b01
	a506_zap.b02::$_url/a506_zap.b02
"

package() {
	# ZAP shader goes directly in /lib/firmware — the msm/adreno driver looks
	# it up unprefixed as "a506_zap.mdt".
	install -Dm644 "$srcdir"/a506_zap.mdt -t "$pkgdir"/lib/firmware
	install -Dm644 "$srcdir"/a506_zap.b00 -t "$pkgdir"/lib/firmware
	install -Dm644 "$srcdir"/a506_zap.b01 -t "$pkgdir"/lib/firmware
	install -Dm644 "$srcdir"/a506_zap.b02 -t "$pkgdir"/lib/firmware
}
sha512sums="
